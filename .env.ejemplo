# Copia este archivo como .env y llena tus valores REALES.
# El archivo .env esta en .gitignore: nunca debe llegar al repositorio.
DB_HOST=tu-instancia.xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
AWS_REGION=us-east-1
S3_BUCKET=

# Secreto para firmar los tokens de sesion (JWT). Genera uno propio, largo y aleatorio.
JWT_SECRET=

# Solo necesarias si corres la app FUERA de una instancia de AWS con rol IAM
# (por ejemplo probando en tu laptop). En una instancia EC2 con rol asociado,
# dejalas vacias: boto3 usa el rol automaticamente.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
